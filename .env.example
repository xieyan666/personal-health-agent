# PostgreSQL container and host-side Backend connection.
POSTGRES_DB=<database>
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<database>

# Redis container and host-side Backend connection.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant container and host-side Backend connection. API key may be empty locally.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO container and host-side Backend connection.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<local-dev-user>
MINIO_SECRET_KEY=<local-dev-password>
MINIO_SECURE=false
MINIO_KNOWLEDGE_BUCKET=knowledge-files
MAX_KNOWLEDGE_FILE_SIZE_MB=20

# AI provider. Leave empty to run without external model calls.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
